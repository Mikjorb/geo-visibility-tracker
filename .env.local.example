# Copia este archivo a .env.local y rellena los valores. NO commitees .env.local

# --- Base de datos Postgres (Supabase recomendado, plan gratis) ---
# Formato: postgresql://usuario:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Claves de API de los proveedores LLM (rellena solo las que vayas a usar) ---
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Seguridad del endpoint de ejecución (opcional) ---
# Token que protege /api/run en disparos externos (curl o un cron del sistema).
# Déjalo vacío en uso local. Genera uno con: openssl rand -hex 32
RUN_SECRET=

# --- Contraseña de acceso a la app (puerta de login) ---
# Si se deja vacía, la app queda ABIERTA (útil en local). Ponla solo si expones la app fuera de tu equipo.
APP_PASSWORD=
